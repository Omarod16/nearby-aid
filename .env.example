# NearbyAid — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real secrets/keys to source control.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NearbyAid
NEXT_PUBLIC_SITE_DOMAIN=nearbyaid.co.uk

# Postcode / Geocoding (Phase 2)
# postcodes.io is open & free without an API key by default.
# POSTCODES_IO_API_URL=https://api.postcodes.io

# Cloudflare D1 Database (Phase 3)
# Set when binding or querying Cloudflare D1
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# External Service Data APIs (Phase 4 & Phase 5)
# NHS_DIGITAL_API_KEY=
# NHS_ODS_API_URL=

# Maps (Phase 6)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
