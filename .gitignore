# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production builds
/build
/dist

# Cloudflare & Wrangler local state & databases
.wrangler/
.d1/

# Environment variables & secrets (NEVER commit secrets or API keys)
.env*
!.env.example

# Security, keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.secret
credentials.json
service-account*.json
token.json

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDEs and Editors
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
